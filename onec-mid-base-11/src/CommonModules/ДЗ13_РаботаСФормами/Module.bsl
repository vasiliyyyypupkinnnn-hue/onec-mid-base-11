#Область СлужебныйПрограммныйИнтерфейс

Процедура ДобавитьВФорму(Форма) Экспорт
	
	ИмяФормы = Форма.ИмяФормы;
	
	Если ИмяФормы = "Документ.ЗаказПокупателя.Форма.ФормаДокумента" Тогда
		ДобавитьПолеКонтактноеЛицоВГруппу( Форма );
	ИначеЕсли ИмяФормы = "Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокумента" Тогда
		ДобавитьПолеКонтактноеЛицоВГруппу( Форма );
	ИначеЕсли ИмяФормы = "Документ.РеализацияТоваровУслуг.Форма.ФормаДокумента" Тогда
		ДобавитьПолеКонтактноеЛицоВГруппу( Форма );
	ИначеЕсли ИмяФормы = "Документ.ОплатаОтПокупателя.Форма.ФормаДокумента" Тогда
		ДобавитьПолеКонтактноеЛицоПередПослеСуммы( Форма );
	ИначеЕсли ИмяФормы = "Документ.ОплатаПоставщику.Форма.ФормаДокумента" Тогда
		ДобавитьПолеКонтактноеЛицоПередПослеСуммы( Форма );
	КонецЕсли
	
КонецПроцедуры

Процедура ДобавитьПолеКонтактноеЛицоВГруппу( Форма )
	
	ПолеВвода = Форма.Элементы.Добавить("КонтактноеЛицо", Тип("ПолеФормы"), Форма.Элементы.ГруппаШапкаПраво );
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.ДЗ13_КонтактноеЛицо";
	
КонецПроцедуры

Процедура ДобавитьПолеКонтактноеЛицоПередПослеСуммы( Форма )
	
	ПолеВвода = Форма.Элементы.Вставить("КонтактноеЛицо", Тип("ПолеФормы"), ,Форма.Элементы.СуммаДокумента );
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.ДЗ13_КонтактноеЛицо";
	
КонецПроцедуры


Процедура ДобавитьПоляИКомандыДляСкидки( Форма ) Экспорт

	Если Форма.ИмяФормы <> "Документ.ЗаказПокупателя.Форма.ФормаДокумента" Тогда
		Возврат;
	КонецЕсли;
	
	ПолеГруппа = Форма.Элементы.Добавить("ГруппаСкидка", Тип("ГруппаФормы"), Форма.Элементы.ГруппаШапкаЛево );
	ПолеГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ПолеГруппа.ОтображатьЗаголовок = Ложь;
	ПолеГруппа.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	
	ПолеВвода = Форма.Элементы.Добавить("СогласованнаяСкидка", Тип("ПолеФормы"), ПолеГруппа); //Элементы.ГруппаСкидка );
	ПолеВвода.Вид = ВидПоляФормы.ПолеВвода;
	ПолеВвода.ПутьКДанным = "Объект.ДЗ13_СогласованнаяСкидка";
	ПолеВвода.УстановитьДействие( "ПриИзменении", "ПриИзмененииСогласованнойСкидки" );
	
	Команда = Форма.Команды.Добавить("ПересчитатьТаблицу");
	Команда.Заголовок = "Пересчитать таблицу";
	Команда.Действие = "ПрименитьСкидкуДляВсегоДокумента";
	
	КнопкаФормы = Форма.Элементы.Добавить("КнопкаПересчитатьТаблицу", Тип("КнопкаФормы"), ПолеГруппа); //Элементы.ГруппаСкидка );
	КнопкаФормы.ИмяКоманды = "ПересчитатьТаблицу";
	КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;	

КонецПроцедуры

#КонецОбласти