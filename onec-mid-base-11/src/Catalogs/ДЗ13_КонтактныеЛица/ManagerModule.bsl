#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	КороткоеФИО = ДЗ13_РаботаСоСтрокамиКлиентСервер.СократитьФИО( Данные.Наименование );
	
	Если ЗначениеЗаполнено( Данные.Ссылка.ДействуетНаОсновании ) Тогда
		Представление = СтрШаблон("%1 (на осн. %2)", КороткоеФИО, Данные.Ссылка.ДействуетНаОсновании );
	Иначе
		Представление = КороткоеФИО;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти